<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vlor999.jauge.daemon</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/chargekeeperctl</string>
    <key>ProgramArguments</key>
    <array>
        <string>chargekeeperctl</string>
        <string>daemon</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.vlor999.jauge</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/jauge.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/jauge.log</string>
</dict>
</plist>
